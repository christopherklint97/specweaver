// Server represents all server handlers
type Server interface {
{{- range .Operations }}
{{- if .Summary }}
	// {{ .HandlerName }} {{ .Summary }}
{{- end }}
	{{ .HandlerName }}(ctx context.Context, req {{ .RequestTypeName }}) ({{ .ResponseTypeName }}, error)
{{- end }}
}

// ServerWrapper wraps the Server with HTTP handler logic
type ServerWrapper struct {
	Handler Server
}

{{- range .Operations }}

// handle{{ .HandlerName }} adapts HTTP request to {{ .HandlerName }} handler
func (w *ServerWrapper) handle{{ .HandlerName }}(rw http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	req := {{ .RequestTypeName }}{}

{{- range .PathParams }}
	// Parse path parameter: {{ .ParamName }}
	{{ .ParamName }}Str := router.URLParam(r, "{{ .ParamName }}")
{{- if eq .BaseType "string" }}
	req.{{ .FieldName }} = {{ .ParamName }}Str
{{- else if or (eq .BaseType "int") (eq .BaseType "int32") (eq .BaseType "int64") }}
	{{ .ParamName }}Val, err := strconv.ParseInt({{ .ParamName }}Str, 10, {{ .BitSize }})
	if err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid {{ .ParamName }} parameter"))
		return
	}
{{- if eq .BaseType "int" }}
	req.{{ .FieldName }} = int({{ .ParamName }}Val)
{{- else }}
	req.{{ .FieldName }} = {{ .BaseType }}({{ .ParamName }}Val)
{{- end }}
{{- else if or (eq .BaseType "float32") (eq .BaseType "float64") }}
	{{ .ParamName }}Val, err := strconv.ParseFloat({{ .ParamName }}Str, {{ .BitSize }})
	if err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid {{ .ParamName }} parameter"))
		return
	}
	req.{{ .FieldName }} = {{ .BaseType }}({{ .ParamName }}Val)
{{- else if eq .BaseType "bool" }}
	{{ .ParamName }}Val, err := strconv.ParseBool({{ .ParamName }}Str)
	if err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid {{ .ParamName }} parameter"))
		return
	}
	req.{{ .FieldName }} = {{ .ParamName }}Val
{{- end }}

{{- end }}
{{- range .QueryParams }}
	// Parse query parameter: {{ .ParamName }}
	{{ .ParamName }}Str := r.URL.Query().Get("{{ .ParamName }}")
{{- if .Required }}
{{- if eq .BaseType "string" }}
	req.{{ .FieldName }} = {{ .ParamName }}Str
{{- else if or (eq .BaseType "int") (eq .BaseType "int32") (eq .BaseType "int64") }}
	{{ .ParamName }}Val, err := strconv.ParseInt({{ .ParamName }}Str, 10, {{ .BitSize }})
	if err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid {{ .ParamName }} parameter"))
		return
	}
{{- if eq .BaseType "int" }}
	req.{{ .FieldName }} = int({{ .ParamName }}Val)
{{- else }}
	req.{{ .FieldName }} = {{ .BaseType }}({{ .ParamName }}Val)
{{- end }}
{{- else if or (eq .BaseType "float32") (eq .BaseType "float64") }}
	{{ .ParamName }}Val, err := strconv.ParseFloat({{ .ParamName }}Str, {{ .BitSize }})
	if err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid {{ .ParamName }} parameter"))
		return
	}
	req.{{ .FieldName }} = {{ .BaseType }}({{ .ParamName }}Val)
{{- else if eq .BaseType "bool" }}
	{{ .ParamName }}Val, err := strconv.ParseBool({{ .ParamName }}Str)
	if err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid {{ .ParamName }} parameter"))
		return
	}
	req.{{ .FieldName }} = {{ .ParamName }}Val
{{- end }}
{{- else }}
	if {{ .ParamName }}Str != "" {
{{- if eq .BaseType "string" }}
		req.{{ .FieldName }} = &{{ .ParamName }}Str
{{- else if or (eq .BaseType "int") (eq .BaseType "int32") (eq .BaseType "int64") }}
		{{ .ParamName }}Val, err := strconv.ParseInt({{ .ParamName }}Str, 10, {{ .BitSize }})
		if err == nil {
{{- if eq .BaseType "int" }}
			{{ .ParamName }}Int := int({{ .ParamName }}Val)
			req.{{ .FieldName }} = &{{ .ParamName }}Int
{{- else }}
			{{ .ParamName }}Typed := {{ .BaseType }}({{ .ParamName }}Val)
			req.{{ .FieldName }} = &{{ .ParamName }}Typed
{{- end }}
		}
{{- else if or (eq .BaseType "float32") (eq .BaseType "float64") }}
		{{ .ParamName }}Val, err := strconv.ParseFloat({{ .ParamName }}Str, {{ .BitSize }})
		if err == nil {
			{{ .ParamName }}Typed := {{ .BaseType }}({{ .ParamName }}Val)
			req.{{ .FieldName }} = &{{ .ParamName }}Typed
		}
{{- else if eq .BaseType "bool" }}
		{{ .ParamName }}Val, err := strconv.ParseBool({{ .ParamName }}Str)
		if err == nil {
			req.{{ .FieldName }} = &{{ .ParamName }}Val
		}
{{- end }}
	}
{{- end }}

{{- end }}
{{- if .HasRequestBody }}
	// Parse request body
	if err := ReadJSON(r, &req.Body); err != nil {
		w.handleError(rw, NewHTTPError(http.StatusBadRequest, "invalid request body"))
		return
	}

{{- end }}
	// Call handler
	resp, err := w.Handler.{{ .HandlerName }}(ctx, req)
	if err != nil {
		w.handleError(rw, err)
		return
	}

	// Write response
	WriteResponse(rw, resp)
}
{{- end }}

// handleError handles errors and writes appropriate HTTP responses
func (w *ServerWrapper) handleError(rw http.ResponseWriter, err error) {
	var httpErr *HTTPError
	if errors.As(err, &httpErr) {
		WriteError(rw, httpErr.Code, httpErr)
		return
	}
	// Default to 500 Internal Server Error
	WriteError(rw, http.StatusInternalServerError, err)
}

